FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS builder

WORKDIR /build
COPY web/default/package.json .
COPY web/default/bun.lock .
RUN bun install
COPY ./web/default .
COPY ./VERSION .
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=$(cat VERSION) bun run build

FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS builder-classic

WORKDIR /build
COPY web/classic/package.json .
COPY web/classic/bun.lock .
RUN bun install
COPY ./web/classic .
COPY ./VERSION .
RUN VITE_REACT_APP_VERSION=$(cat VERSION) bun run build

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder2
ENV GO111MODULE=on CGO_ENABLED=0

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
RUN go mod download

ARG BACKEND_CACHE_BUST=0
RUN echo "backend cache bust: ${BACKEND_CACHE_BUST}"
COPY . .
COPY --from=builder /build/dist ./web/default/dist
COPY --from=builder-classic /build/dist ./web/classic/dist
RUN gofmt -w common/api_type.go common/endpoint_type.go constant/api_type.go constant/channel.go controller/antigravity_accounts.go controller/channel.go dto/openai_response.go relay/relay_adaptor.go relay/channel/antigravity/adaptor.go relay/channel/antigravity/manager.go relay/channel/antigravity/oauth_key.go relay/channel/antigravity/oauth_refresh.go relay/channel/codex/adaptor.go relay/channel/openai/adaptor.go relay/channel/openai/relay_responses.go relay/chat_completions_via_responses.go relay/common/relay_info.go relay/helper/stream_scanner.go service/convert.go service/openaicompat/policy.go
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM calciumion/new-api:latest

LABEL org.opencontainers.image.source="https://github.com/liwenqiang11/new-api-custom"

COPY --from=builder2 /build/new-api /new-api
