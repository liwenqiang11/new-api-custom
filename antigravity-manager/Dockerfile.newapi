FROM node:22-bookworm-slim AS builder

ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --prefer-offline --fetch-retries=5 --fetch-retry-factor=2 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

COPY . .
RUN npx vite build --config vite.server.config.mts

FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=8045 \
    ANTIGRAVITY_MANAGER_CREDENTIALS_FILE=/data/antigravity-manager-credentials.json \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --omit=dev --prefer-offline --fetch-retries=5 --fetch-retry-factor=2 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 && npm cache clean --force

COPY --from=builder /app/dist-server ./dist-server

EXPOSE 8045
CMD ["node", "dist-server/standalone.cjs"]
